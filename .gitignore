.Trashes

# Application logs (preserve log directory via .gitkeep)
logs/*.log
*.log

# Models and checkpoints (preserve directory via .gitkeep)
models/*.joblib
models/*.pkl
models/*.pt
models/*.onnx

# Raw and processed datasets (preserve sample/test data and .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
