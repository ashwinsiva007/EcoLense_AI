# EconLens AI - Environment Configuration Template
# Copy this file to .env and adjust values for local development.

# Application Information
APP_NAME=EconLens AI
APP_ENV=development
APP_DEBUG=true

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_TO_FILE=true

# Storage and Directories (relative to project root or absolute paths)
DATA_DIR=data
MODEL_DIR=models
LOG_DIR=logs

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
STREAMLIT_THEME_BASE=dark
